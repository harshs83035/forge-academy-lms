// Source of truth for the data model. prisma/init.sql mirrors it (hand-written so setup
// works without downloading Prisma's schema engine; `prisma db push` also works if you prefer).
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  LEARNER
}

model User {
  id           String   @id @default(cuid())
  code         String   @unique // human-friendly ID shown in watermark, e.g. LRN-1001
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(LEARNER)
  active       Boolean  @default(true)
  maxDevices   Int? // per-user override of global device limit
  createdById  String?
  createdAt    DateTime @default(now())

  devices      Device[]
  sessions     Session[]
  enrollments  Enrollment[]
  progress     Progress[]
  attempts     Attempt[]
  certificates Certificate[]
}

model Device {
  id          String   @id @default(cuid())
  userId      String
  fingerprint String
  label       String
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprint])
}

model Session {
  id            String    @id @default(cuid())
  userId        String
  deviceId      String?
  ip            String?
  userAgent     String?
  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  revokedAt     DateTime?
  revokeReason  String? // REPLACED | LOGOUT | ADMIN | DEACTIVATED
  streamId      String? // currently active playback stream (duplicate-stream detection)
  streamVideoId String?
  streamAt      DateTime?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Course {
  id          String       @id @default(cuid())
  title       String
  description String       @default("")
  position    Int          @default(0)
  passMark    Int          @default(70)
  sequential  Boolean      @default(true)
  published   Boolean      @default(true)
  createdAt   DateTime     @default(now())
  videos      Video[]
  quiz        Quiz?
  enrollments Enrollment[]
  certificates Certificate[]
}

model Video {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String   @default("")
  position    Int      @default(0)
  durationSec Int      @default(0)
  hlsDir      String // folder under MEDIA_ROOT holding the encrypted HLS package
  status      String   @default("READY") // READY | PROCESSING
  sourceName  String?
  createdAt   DateTime @default(now())
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tracks      VideoAudioTrack[]
  progress    Progress[]
}

model VideoAudioTrack {
  id        String  @id @default(cuid())
  videoId   String
  lang      String // en | hi
  label     String
  isDefault Boolean @default(false)
  video     Video   @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, lang])
}

model Enrollment {
  userId     String
  courseId   String
  assignedAt DateTime @default(now())
  assignedBy String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([userId, courseId])
}

model Progress {
  id          String    @id @default(cuid())
  userId      String
  videoId     String
  positionSec Float     @default(0)
  watchedSec  Float     @default(0) // server-validated seconds actually watched
  completed   Boolean   @default(false)
  completedAt DateTime?
  updatedAt   DateTime  @default(now()) @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  video       Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
}

model Quiz {
  id        String     @id @default(cuid())
  courseId  String     @unique
  title     String
  course    Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions Question[]
  attempts  Attempt[]
}

model Question {
  id           String @id @default(cuid())
  quizId       String
  text         String
  options      Json // string[]
  correctIndex Int
  position     Int    @default(0)
  quiz         Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model Attempt {
  id        String   @id @default(cuid())
  userId    String
  quizId    String
  score     Int // percent
  passed    Boolean
  answers   Json
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model Certificate {
  id        String   @id @default(cuid())
  certId    String   @unique
  userId    String
  courseId  String
  score     Int?
  issuedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  resource  String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}

model Setting {
  key   String @id
  value Json
}
