{
  "name": "forge-academy-lms",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "db:init": "node scripts/db-init.mjs",
    "db:seed": "tsx scripts/seed.ts",
    "narration:test": "python3 narration/tests/test_narration.py",
